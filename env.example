# Stellar / Soroban
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Contract
VACCINATIONS_CONTRACT_ID=

# Backend auth
ADMIN_SECRET_KEY=
ADMIN_PUBLIC_KEY=
SEP10_SERVER_KEY=
ISSUER_SECRET_KEY=
JWT_SECRET=

# Ports
PORT=4000
ANALYTICS_PORT=8001

# Persistence strategy for the event index (see docs/persistence-strategy.md)
# sqlite: single-writer SQLite index (default, suitable for single backend instance)
# postgres: multi-writer PostgreSQL index (required for multiple backend instances)
EVENT_INDEX_STORE=sqlite
# SQLite database file path (used when EVENT_INDEX_STORE=sqlite)
EVENT_INDEX_SQLITE_PATH=./event-index.sqlite
# PostgreSQL connection string (used when EVENT_INDEX_STORE=postgres)
EVENT_INDEX_DATABASE_URL=
# Connection pool size for the multi-writer database
EVENT_INDEX_POOL_SIZE=10
# Lock acquisition timeout in milliseconds for index writes
EVENT_INDEX_LOCK_TIMEOUT_MS=5000
# Interval in milliseconds between index backup snapshots (0 disables)
EVENT_INDEX_BACKUP_INTERVAL_MS=3600000
# Number of backup snapshots to retain
EVENT_INDEX_BACKUP_RETENTION=7

# Public verification response limits (see docs/public-verification-limits.md)
# Maximum number of history records returned per public record response
PUBLIC_RECORD_MAX_HISTORY=100
# Default page size for paginated public record responses
PUBLIC_RECORD_PAGE_SIZE=25
# Maximum number of items accepted in a single batch verification request
PUBLIC_BATCH_MAX_SIZE=50
# Maximum serialized response size in bytes before truncation
PUBLIC_RESPONSE_MAX_BYTES=1048576

# Proxy / client IP derivation (see docs/proxy-topology.md)
# Express trust-proxy setting: false, true, a number of hops, or a comma-separated
# list of trusted subnets. Must match the deployed load-balancer topology.
TRUST_PROXY=false
# Header used to derive the client IP when behind a trusted proxy
CLIENT_IP_HEADER=x-forwarded-for

# Audit log (append-only NDJSON file, defaults to backend/audit.log)
AUDIT_LOG_PATH=./audit.log
# Enable tamper-evident hash chaining of audit log entries
AUDIT_LOG_HASH_CHAIN=true
# Maximum size in bytes of a single audit log file before rotation
AUDIT_LOG_MAX_BYTES=10485760
# Number of rotated audit log files to retain
AUDIT_LOG_RETENTION_FILES=10
# Retention period in days for audit log entries
AUDIT_LOG_RETENTION_DAYS=90
# Behavior when audit logging fails: fail (reject request) or log (continue)
AUDIT_LOG_FAILURE_MODE=fail

# Backup service
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
RETENTION_DAYS=30