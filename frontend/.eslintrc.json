{
  "env": { "browser": true, "es2021": true },
  "extends": ["eslint:recommended", "plugin:react/recommended"],
  "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
  "plugins": ["react"],
  "settings": { "react": { "version": "detect" } },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-restricted-syntax": [
      "error",
      {
        "selector": "JSXOpeningElement[name.name='a'][attributes.attribute[name.name='target'][value.value='_blank']]:not(:has(attributes.attribute[name.name='rel'][value.value=/noopener/][value.value=/noreferrer/]))",
        "message": "Links with target=\"_blank\" must include rel=\"noopener noreferrer\" to prevent the new tab from controlling the originating window."
      }
    ]
  }
}