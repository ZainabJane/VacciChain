# ── Stellar / Soroban ────────────────────────────────────────────────────────
# testnet | mainnet  (default: testnet)
STELLAR_NETWORK=testnet

# Horizon REST API for the chosen network
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC endpoint for contract simulation and submission
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Must exactly match the target network passphrase
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Contract ─────────────────────────────────────────────────────────────────
# 56-char contract address starting with C — output of `make deploy`
VACCINATIONS_CONTRACT_ID=

# ── Backend auth ─────────────────────────────────────────────────────────────
# Secret key for admin contract invocations (starts with S)
ADMIN_SECRET_KEY=

# Public key matching ADMIN_SECRET_KEY (starts with G) — grants issuer role on login
ADMIN_PUBLIC_KEY=

# Dedicated secret key for signing SEP-10 challenges (starts with S)
SEP10_SERVER_KEY=

# SEP-10: home domain — used as the manage_data key prefix ('<HOME_DOMAIN> auth')
# Must match the domain in your stellar.toml (e.g. vaccichain.example.com)
HOME_DOMAIN=localhost

# SEP-10: domain of this auth server — included in the web_auth_domain manage_data operation
# May differ from HOME_DOMAIN when the auth server is on a subdomain
WEB_AUTH_DOMAIN=localhost

# Secret key for signing mint/revoke transactions (starts with S)
ISSUER_SECRET_KEY=

# JWT signing secret — min 32 chars recommended; rotate to invalidate sessions
JWT_SECRET=

# kid (key ID) for the current JWT signing key — increment on each rotation
JWT_KEY_ID=1

# Comma-separated list of previous JWT secrets still valid for verification
# during the transition window after a rotation. Remove entries once all
# tokens signed with those secrets have expired.
# Example: JWT_PREVIOUS_KEYS=

# JWT issuer/audience pinned on issue and verify (#47). Issuer defaults to HOME_DOMAIN.
JWT_ISSUER=
JWT_AUDIENCE=vaccichain-api
# Seconds a key rotated out via /v1/admin/jwt/rotate keeps verifying (default: token lifetime)
JWT_ROTATION_OVERLAP_SECONDS=3600oldSecret1,oldSecret2
JWT_PREVIOUS_KEYS=

# ── Backend server ────────────────────────────────────────────────────────────
# TCP port for the Express backend (default: 4000)
PORT=4000

# Maximum JSON request body size accepted by the API (default: 10kb)
BODY_LIMIT=10kb

# Comma-separated list of allowed CORS origins (default: http://localhost:3000)
# Example: https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000

# Max retries for Soroban RPC calls before failing (default: 3)
SOROBAN_RPC_MAX_RETRIES=3

# Base transaction fee in stroops (1 XLM = 10,000,000 stroops; default: 100)
SOROBAN_FEE=100

# Fee bump tip in stroops to prioritise transactions (default: 0)
SOROBAN_TIP=0

# How often (ms) the event indexer polls the backend for new contract events (default: 15000)
EVENT_POLL_INTERVAL_MS=15000

# Path to the SQLite database file used by the indexer (default: /data/vaccichain.db)
DATABASE_PATH=/data/vaccichain.db

# ── Event index persistence strategy ─────────────────────────────────────────
# Storage backend for the event index: sqlite | postgres (default: sqlite)
# sqlite: single-writer, file-backed — suitable for a single backend instance.
# postgres: multi-writer, network-backed — required when running more than one
# backend task. See docs/persistence-strategy.md for the load/failure analysis.
INDEX_STORAGE=sqlite

# Postgres connection string — required when INDEX_STORAGE=postgres
# Example: postgres://user:pass@db:5432/vaccichain?sslmode=require
DATABASE_URL=

# Max connections in the Postgres pool (default: 10)
DATABASE_POOL_MAX=10

# How long (ms) a connection attempt may wait before failing (default: 5000)
DATABASE_CONNECT_TIMEOUT_MS=5000

# Advisory-lock key used to serialise indexer writes across instances (default: 1)
# Must be identical on every backend task sharing the same database.
INDEX_LOCK_KEY=1

# How often (ms) the indexer renews its advisory lock (default: 10000)
INDEX_LOCK_RENEW_MS=10000

# ── Public verification limits ────────────────────────────────────────────────
# Max records returned in a single public verification response (default: 100)
VERIFY_MAX_RECORDS=100

# Default page size when the caller does not specify one (default: 20)
VERIFY_DEFAULT_PAGE_SIZE=20

# Max items accepted in a single batch verification request (default: 50)
VERIFY_BATCH_MAX_ITEMS=50

# Max number of pages a caller may traverse per record history (default: 10)
VERIFY_MAX_PAGES=10

# ── Proxy / client IP derivation ──────────────────────────────────────────────
# Express trust-proxy setting. Must match the deployed load-balancer topology.
# Accepts: false | true | loopback | linklocal | uniquelocal | a hop count (e.g. 1)
# or a comma-separated list of trusted CIDRs/subnets.
# Default: loopback (trust only a proxy on the same host)
TRUST_PROXY=loopback

# Header carrying the original client IP when behind a proxy (default: X-Forwarded-For)
CLIENT_IP_HEADER=X-Forwarded-For

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max SEP-10 challenge requests per IP per minute (default: 10)
RATE_LIMIT_SEP10=10

# Max public verify requests per IP per minute (default: 60)
RATE_LIMIT_VERIFY=60

# ── Brute-force protection ────────────────────────────────────────────────────
# Max failed /auth/verify attempts before blocking (default: 5)
BRUTE_FORCE_MAX_ATTEMPTS=5

# Sliding window for counting failures in milliseconds (default: 600000 = 10 min)
BRUTE_FORCE_WINDOW_MS=600000

# How long a blocked IP/wallet stays blocked in milliseconds (default: 900000 = 15 min)
BRUTE_FORCE_BLOCK_MS=900000

# ── Audit log ─────────────────────────────────────────────────────────────────
# Path to append-only NDJSON audit log (default: ./audit.log)
AUDIT_LOG_PATH=./audit.log

# Max size (bytes) of a single audit log file before rotation (default: 10485760 = 10 MiB)
AUDIT_LOG_MAX_BYTES=10485760

# Number of rotated audit log files to retain (default: 10)
AUDIT_LOG_MAX_FILES=10

# How long (days) rotated audit log files are retained before deletion (default: 90)
AUDIT_LOG_RETENTION_DAYS=90

# Enable tamper-evident hash chaining of audit entries (default: true)
AUDIT_LOG_INTEGRITY=true

# Secret used to key the audit log HMAC chain — required when AUDIT_LOG_INTEGRITY=true
# Generate with: openssl rand -hex 32
AUDIT_LOG_HMAC_KEY=

# Path to the audit log integrity checkpoint file (default: ./audit.log.checkpoint)
AUDIT_LOG_CHECKPOINT_PATH=./audit.log.checkpoint

# Behaviour when an audit write fails: fail (reject the request) | log (continue)
# Default: fail — issuer actions must not proceed unattributed.
AUDIT_LOG_FAILURE_MODE=fail

# ── Python analytics service ──────────────────────────────────────────────────
# TCP port for the FastAPI analytics service (default: 8001)
ANALYTICS_PORT=8001

# Base URL the analytics service uses to reach the backend (default set by Compose)
BACKEND_URL=http://backend:4000

# API key required to access protected analytics endpoints (rates, issuers, anomalies)
# Generate with: openssl rand -hex 32
ANALYTICS_API_KEY=

# Python log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (default: INFO)
LOG_LEVEL=INFO

# ── Anomaly detection ─────────────────────────────────────────────────────────
# Mint count above which an issuer is flagged as anomalous (default: 50)
ANOMALY_THRESHOLD=50

# How often (minutes) the anomaly detection job runs (default: 15)
ANOMALY_SCHEDULE_MINUTES=15

# Webhook URL to POST alerts to when anomalies are detected (leave empty to disable)
# Example (Slack): https://hooks.slack.com/services/TXXXXXXXXX/BXXXXXXXXX/XXXXXXXX
ALERT_WEBHOOK_URL=

# Webhook payload format: slack | pagerduty | email (default: slack)
ALERT_WEBHOOK_TYPE=slack

# PagerDuty Events API v2 routing key — required when ALERT_WEBHOOK_TYPE=pagerduty
# Set ALERT_WEBHOOK_URL=https://events.pagerduty.com/v2/enqueue
PAGERDUTY_ROUTING_KEY=

# Recipient email address — required when ALERT_WEBHOOK_TYPE=email
ALERT_EMAIL_TO=

# ── Backup service ────────────────────────────────────────────────────────────
# S3 Bucket for analytics DB backup
S3_BUCKET_NAME=
# AWS Credentials for S3 access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Number of days to retain backups
RETENTION_DAYS=30
DEMO_ISSUER_SECRET=
ADMIN_SECRET=

# ── Secrets Management (Production) ───────────────────────────────────────────
# Enable AWS Secrets Manager for production (default: false)
USE_AWS_SECRETS=false

# AWS Secrets Manager secret name/ARN containing all secrets
# Example: arn:aws:secretsmanager:us-east-1:123456789012:secret:vaccichain/prod/stellar
AWS_SECRET_NAME=

# AWS region for Secrets Manager (default: us-east-1)
AWS_REGION=us-east-1

# ── Admin multi-signature ─────────────────────────────────────────────────────
# Number of approvals required for critical admin operations (default: 2)
MULTISIG_THRESHOLD=2

# Comma-separated list of wallet addresses authorised to approve proposals.
# Leave empty to allow any admin-role JWT holder to approve.
# Example: MULTISIG_KEY_HOLDERS=GABC...,GDEF...,GHIJ...
MULTISIG_KEY_HOLDERS=

# How long a pending proposal stays valid in milliseconds (default: 3600000 = 1 hour)
MULTISIG_PROPOSAL_TTL_MS=3600000

# ── Verifier API keys ─────────────────────────────────────────────────────────
# Default scopes granted to newly provisioned verifier API keys.
# Comma-separated list of: verify:read, verify:batch, verify:history
# Example: VERIFIER_API_KEY_DEFAULT_SCOPES=verify:read,verify:batch
VERIFIER_API_KEY_DEFAULT_SCOPES=verify:read

# Lifetime of a verifier API key in days before it must be rotated (default: 90)
# Set to 0 to disable expiry (not recommended in production)
VERIFIER_API_KEY_TTL_DAYS=90

# Grace period in hours during which a rotated-out key still verifies
# (allows clients to roll over without downtime; default: 24)
VERIFIER_API_KEY_ROTATION_GRACE_HOURS=24

# Max number of active (non-revoked, non-expired) keys per verifier (default: 5)
VERIFIER_API_KEY_MAX_ACTIVE=5

# ── Background jobs ───────────────────────────────────────────────────────────
# Max number of items processed per batch in background workers (default: 500)
JOB_BATCH_SIZE=500

# Max wall-clock time a single background job may run in milliseconds (default: 300000 = 5 min)
JOB_TIMEOUT_MS=300000

# How often (ms) job status is refreshed/persisted for observability (default: 5000)
JOB_STATUS_POLL_INTERVAL_MS=5000

# Max number of concurrent background jobs (default: 2)
JOB_MAX_CONCURRENCY=2


# Set to 'false' to waive consent requirement (e.g. jurisdiction config).
# Default: true (consent required before minting)
REQUIRE_PATIENT_CONSENT=true
