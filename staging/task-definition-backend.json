{
  "family": "vaccichain-staging",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "desiredCount": 1,
  "deploymentConfiguration": {
    "maximumPercent": 100,
    "minimumHealthyPercent": 0
  },
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/vaccichain-frontend:staging-latest",
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://localhost/healthz || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vaccichain-staging/frontend",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "frontend"
        }
      },
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ]
    },
    {
      "name": "backend",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/vaccichain-backend:staging-latest",
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "STELLAR_NETWORK",
          "value": "testnet"
        },
        {
          "name": "HORIZON_URL",
          "value": "https://horizon-testnet.stellar.org"
        },
        {
          "name": "SOROBAN_RPC_URL",
          "value": "https://soroban-testnet.stellar.org"
        },
        {
          "name": "STELLAR_NETWORK_PASSPHRASE",
          "value": "Test SDF Network ; September 2015"
        },
        {
          "name": "USE_AWS_SECRETS",
          "value": "true"
        },
        {
          "name": "AWS_SECRET_NAME",
          "value": "vaccichain/staging/stellar"
        },
        {
          "name": "PORT",
          "value": "4000"
        },
        {
          "name": "DEPLOYMENT_ENV",
          "value": "staging"
        },
        {
          "name": "BACKEND_WRITER_MODE",
          "value": "single-writer"
        },
        {
          "name": "SQLITE_DB_PATH",
          "value": "/mnt/efs/vaccichain/staging/vaccichain.db"
        },
        {
          "name": "SQLITE_BUSY_TIMEOUT_MS",
          "value": "5000"
        },
        {
          "name": "EFS_MOUNT_PATH",
          "value": "/mnt/efs"
        },
        {
          "name": "AUTOSCALING_MIN_TASKS",
          "value": "1"
        },
        {
          "name": "AUTOSCALING_MAX_TASKS",
          "value": "1"
        },
        {
          "name": "EGRESS_MODE",
          "value": "nat-gateway"
        }
      ],
      "mountPoints": [
        {
          "sourceVolume": "efs-vaccichain-staging",
          "containerPath": "/mnt/efs",
          "readOnly": false
        }
      ],
      "secrets": [
        {
          "name": "VACCINATIONS_CONTRACT_ID",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:VACCINATIONS_CONTRACT_ID::"
        },
        {
          "name": "ADMIN_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:ADMIN_SECRET_KEY::"
        },
        {
          "name": "ADMIN_PUBLIC_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:ADMIN_PUBLIC_KEY::"
        },
        {
          "name": "SEP10_SERVER_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:SEP10_SERVER_KEY::"
        },
        {
          "name": "ISSUER_SECRET_KEY",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:ISSUER_SECRET_KEY::"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:vaccichain/staging/stellar:JWT_SECRET::"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://localhost:4000/health/ready || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vaccichain-staging/backend",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "backend"
        }
      },
      "dependsOn": [
        {
          "containerName": "python-service",
          "condition": "HEALTHY"
        }
      ]
    },
    {
      "name": "python-service",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/vaccichain-python:staging-latest",
      "portMappings": [
        {
          "containerPort": 8001,
          "hostPort": 8001,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "BACKEND_URL",
          "value": "http://backend:4000"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8001/health/ready || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vaccichain-staging/python-service",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "python-service"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "efs-vaccichain-staging",
      "efsVolumeConfiguration": {
        "fileSystemId": "EFS_FILESYSTEM_ID",
        "transitEncryption": "ENABLED",
        "rootDirectory": "/vaccichain/staging"
      }
    }
  ],
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/vaccichain-staging-task-role"
}
